<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Text -->
    <style name="Text.MS" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Text.MS.PageTitle">
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.MS.Subtitle">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.MS.CardTitle">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.MS.Meta">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Text.MS.Label">
        <item name="android:textColor">@color/text_2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Text.MS.Badge">
        <item name="android:textColor">@color/text_2</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:background">@drawable/bg_badge</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="Text.MS.Badge.Accent">
        <item name="android:textColor">@color/accent</item>
        <item name="android:background">@drawable/bg_badge_accent</item>
    </style>

    <style name="Text.MS.FieldError">
        <item name="android:textColor">@color/danger_text</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.MS.Alert">
        <item name="android:textSize">14sp</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Containers -->
    <style name="MS.Card" parent="">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Inputs -->
    <style name="Widget.MS.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="errorTextColor">@color/danger_text</item>
        <item name="boxStrokeErrorColor">@color/danger</item>
        <item name="helperTextTextColor">@color/text_muted</item>
    </style>

    <style name="Widget.MS.TextInput.Dropdown" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="hintTextColor">@color/accent</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="boxCornerRadiusTopStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_control</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_control</item>
        <item name="errorTextColor">@color/danger_text</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.MS.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/button_primary_bg</item>
        <item name="android:textColor">@color/button_primary_text</item>
        <item name="iconTint">@color/button_primary_text</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.MS.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
        <item name="iconTint">@color/text</item>
        <item name="strokeColor">@color/border</item>
        <item name="backgroundTint">@color/surface_2</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.MS.Button.Ghost" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/text_2</item>
        <item name="cornerRadius">@dimen/radius_control</item>
    </style>

    <style name="Widget.MS.Button.Danger" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/danger_text</item>
        <item name="iconTint">@color/danger_text</item>
        <item name="strokeColor">@color/danger</item>
        <item name="cornerRadius">@dimen/radius_control</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.MS.Button.Toggle" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/touch</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="strokeColor">@color/border</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.MS.IconButton" parent="">
        <item name="android:layout_width">@dimen/touch</item>
        <item name="android:layout_height">@dimen/touch</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/text_2</item>
    </style>

    <style name="Widget.MS.IconButton.Danger">
        <item name="tint">@color/danger_text</item>
    </style>

    <style name="Widget.MS.DialogButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Widget.MS.DialogButton.Muted">
        <item name="android:textColor">@color/text_2</item>
    </style>

    <style name="Widget.MS.Chip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/border</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipMinHeight">40dp</item>
    </style>
</resources>
