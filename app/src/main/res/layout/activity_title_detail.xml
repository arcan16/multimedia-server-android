<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        app:navigationContentDescription="Volver al catálogo"
        app:navigationIcon="@drawable/ic_back"
        app:navigationIconTint="@color/text"
        app:title="Volver al catálogo"
        app:titleTextColor="@color/text_2" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/page_padding">

                <include
                    android:id="@+id/state"
                    layout="@layout/view_state" />

                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.multimediaserver.android.ui.common.PosterView
                        android:id="@+id/poster"
                        android:layout_width="180dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/typeBadge"
                            style="@style/Text.MS.Badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/meta"
                            style="@style/Text.MS.Meta"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/name"
                        style="@style/Text.MS.PageTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityHeading="true"
                        android:textSize="28sp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/tags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/synopsis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:lineSpacingMultiplier="1.3"
                        android:textColor="@color/text_2"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/play"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:layout_marginTop="20dp"
                        app:icon="@drawable/ic_play" />

                    <LinearLayout
                        android:id="@+id/adminActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/edit"
                                style="@style/Widget.MS.Button.Secondary"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:text="Editar"
                                app:icon="@drawable/ic_edit" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/delete"
                                style="@style/Widget.MS.Button.Danger"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Eliminar"
                                app:icon="@drawable/ic_delete" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/upload"
                            style="@style/Widget.MS.Button.Secondary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            app:icon="@drawable/ic_upload" />
                    </LinearLayout>

                    <!-- Episodes (series only) -->
                    <LinearLayout
                        android:id="@+id/episodesSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/Text.MS.CardTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:accessibilityHeading="true"
                            android:text="Episodios"
                            android:textSize="20sp" />

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/seasons"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@color/bg"
                            android:contentDescription="Temporadas"
                            android:visibility="gone"
                            app:tabIndicatorColor="@color/accent"
                            app:tabMode="scrollable"
                            app:tabSelectedTextColor="@color/accent"
                            app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Body2"
                            app:tabTextColor="@color/text_muted" />

                        <include
                            android:id="@+id/episodesState"
                            layout="@layout/view_state"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />

                        <LinearLayout
                            android:id="@+id/episodes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_card"
                            android:orientation="vertical"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
